  {
    "id": "q6",
    "category": "Group comparison",
    "number": "06",
    "title": "Group Comparison: Diminishing Returns by Budget Tier",
    "clauses": [
      "SELECT",
      "FROM",
      "GROUP BY",
      "ORDER BY"
    ],
    "question": "How does average multiplier and breakeven profitability percentage decay across discretized budget tiers?",
    "explanation": "Performs categorical GROUP BY aggregation across budget tiers to pinpoint the exact diminishing returns curve. Serves as SQL-to-Visualization #1.",
    "sql": "SELECT \n    budget_tier,\n    COUNT(*) AS movie_count,\n    ROUND(AVG(budget) / 1000000.0, 1) AS avg_budget_mil,\n    ROUND(AVG(revenue) / 1000000.0, 1) AS avg_revenue_mil,\n    ROUND(AVG(revenue / budget), 2) AS avg_multiplier,\n    ROUND(100.0 * SUM(CASE WHEN revenue >= 2.5 * budget THEN 1 ELSE 0 END) / COUNT(*), 1) AS pct_profitable\nFROM movies\nGROUP BY budget_tier\nORDER BY MIN(budget) ASC;",
    "isVisualizationTarget": true,
    "vizType": "bar-trend",
    "vizLabel": "SQL \u2192 Visualization #1: Capital Efficiency vs. Budget Tier",
    "columns": [

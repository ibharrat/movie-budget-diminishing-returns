  {
    "id": "q5",
    "category": "Aggregation",
    "number": "05",
    "title": "Macro Aggregations & Dataset-Wide Financial Summary",
    "clauses": [
      "SELECT",
      "FROM",
      "COUNT",
      "SUM",
      "AVG",
      "MAX"
    ],
    "question": "What are the aggregate industry totals for production capital, worldwide gross, average budget, and peak multiples?",
    "explanation": "Applies standard SQL aggregate functions (COUNT, SUM, AVG, MAX) across the entire theatrical sample to summarize macro economics.",
    "sql": "SELECT \n    COUNT(*) AS total_films_evaluated,\n    ROUND(SUM(budget) / 1000000.0, 1) AS total_budget_millions,\n    ROUND(SUM(revenue) / 1000000.0, 1) AS total_revenue_millions,\n    ROUND(AVG(budget) / 1000000.0, 1) AS avg_budget_millions,\n    ROUND(AVG(revenue) / 1000000.0, 1) AS avg_revenue_millions,\n    ROUND(AVG(revenue / budget), 2) AS avg_multiplier,\n    ROUND(MAX(revenue / budget), 1) AS max_viral_multiplier\nFROM movies\nWHERE budget > 0;",
    "columns": [
      "total_films_evaluated",
      "total_budget_millions",
      "total_revenue_millions",
      "avg_budget_millions",
      "avg_revenue_millions",
      "avg_multiplier",
      "max_viral_multiplier"
    ],
    "rows": [

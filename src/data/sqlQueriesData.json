  {
    "id": "q3",
    "category": "Multiple conditions",
    "number": "03",
    "title": "Multi-Condition Screening for Mid-Budget Breakeven Hits",
    "clauses": [
      "SELECT",
      "FROM",
      "WHERE (BETWEEN, AND, >=)"
    ],
    "question": "Which modern releases (2000+) in the mid-budget range ($25M\u2013$100M) cleared the theatrical 2.5x breakeven rule?",
    "explanation": "Demonstrates compound boolean logic using BETWEEN, AND, and comparison operators to filter modern mid-budget hits.",
    "sql": "SELECT \n    title,\n    release_year,\n    budget,\n    revenue,\n    ROUND(revenue / budget, 2) AS multiplier,\n    'Profitable' AS theatrical_status\nFROM movies\nWHERE budget BETWEEN 25000000 AND 100000000\n  AND revenue >= (2.5 * budget)\n  AND release_year >= 2000\nORDER BY multiplier DESC;",
    "columns": [
      "title",
      "release_year",
      "budget",
      "revenue",
      "multiplier",
      "theatrical_status"
    ],
